# Pinned tool and provider versions for build-release and deploy-env.
# Sourced by lib.sh and install-tools.sh, read by appyaml.mjs. Bump a version and
# its checksum together (checksums are for the linux x86_64 downloads; the
# deployer instance is x86_64). install-tools.sh installs them on the instance
# whenever a release is installed. Node.js is the instance's own (user data).

TERRAFORM_VERSION=1.16.5
TERRAFORM_SHA256=2bc2fcfff033265c9e02ca0351f01794eb122f62a9b2a49a3294b9e49eaab5e4

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# Exact provider versions pinned in every generated root config.
AWS_PROVIDER_VERSION=6.68.0
RANDOM_PROVIDER_VERSION=3.9.1
