# Local development. Copy to .env (git-ignored).

# Fake mode: in-memory GitHub and a simulated runner; no AWS, GitHub or runner needed.
# Plugin API tokens look like "fake:<login>". See README.md.
DEPLOYER_FAKE=1
FAKE_BUILD_SECONDS=5
PORT=8080
DATA_DIR=./data

# --- Against real AWS and a real GitHub App instead (leave DEPLOYER_FAKE unset) ---
# Start the runner too (npm run dev:runner); the deployer finds it at ./data/runner/runner.sock.
# AWS_PROFILE=...
# AWS_REGION=ca-west-1
# GITHUB_ORG=acme
# PUBLIC_URL=https://xxxx.ngrok.app        # where GitHub can reach /webhooks/github
# RUNNER_SOCKET=./data/runner/runner.sock
# ALERTS_TOPIC_ARN=arn:aws:sns:ca-west-1:<account>:slipway-alerts
# Either read the App from Secrets Manager...
# GITHUB_APP_SECRET_ID=slipway/github-app
# ...or give it directly (a test App, not the production one):
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=...

# --- The runner (npm run dev:runner) ---
# RUNNER_DEV=1 is set by the npm script: verify runs as you, with your tools.
# RUNNER_MAX_BUILDS=1
