{
  "name": "slipway-deployer",
  "version": "0.1.0",
  "private": true,
  "description": "slipway deployer: dashboard, plugin API, GitHub webhooks, the job worker, and the runner that runs builds and deploys",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:css && tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:fake": "npm run build:css && DEPLOYER_FAKE=1 tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:css": "tailwindcss -i styles/app.css -o views/static/app.css --watch",
    "dev:runner": "RUNNER_DEV=1 tsx watch --env-file-if-exists=.env src/runner/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run build:css",
    "build:css": "tailwindcss -i styles/app.css -o views/static/app.css --minify",
    "start": "node dist/server.js",
    "start:runner": "node dist/runner/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "create-admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1149.0",
    "@aws-sdk/client-cloudwatch": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/client-sns": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@octokit/app": "^16.1.4",
    "@octokit/webhooks": "^14.2.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@heroui/styles": "3.2.6",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": false
  }
}
