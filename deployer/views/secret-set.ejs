<%- include("partials/head") %>
<div class="mx-auto mt-12 max-w-md">
  <div class="card card--default gap-5 p-6">
    <div class="card__header">
      <h1 class="text-xl font-semibold tracking-tight">Set <code><%= link.key %></code></h1>
      <p class="card__description">For <b class="text-foreground"><%= link.app %></b> in <b class="text-foreground"><%= link.env %></b>, requested by <%= link.createdBy %>.</p>
    </div>
    <p class="text-sm text-muted">
      The value goes straight to AWS Parameter Store. Nobody can view it afterwards, and this link works once.
      <% if (deployed) { %>Save and deploy redeploys <%= link.env %> so the app picks it up now; Save only keeps it for <%= link.env %>'s next deploy.<% } else { %><%= link.env %> hasn't been deployed yet; its first deploy will use it.<% } %>
    </p>
    <% if (error) { %><div class="alert alert--danger" role="alert"><div class="alert__content"><p class="alert__description text-danger"><%= error %></p></div></div><% } %>
    <form method="post" class="flex flex-col gap-4" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="textfield textfield--full-width">
        <label class="label" for="value">Value</label>
        <input class="input" type="password" id="value" name="value" required autofocus>
      </div>
      <% if (deployed) { %>
      <button class="button button--primary button--full-width" name="deploy" value="1">Save and deploy <%= link.env %></button>
      <button class="button button--secondary button--full-width" name="deploy" value="0">Save only</button>
      <% } else { %>
      <button class="button button--primary button--full-width" name="deploy" value="0">Save <%= link.key %></button>
      <% } %>
    </form>
  </div>
</div>
<%- include("partials/foot") %>
