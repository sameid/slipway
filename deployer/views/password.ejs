<%- include("partials/head") %>
<div class="mx-auto mt-12 max-w-sm">
  <div class="card card--default gap-5 p-6">
    <div class="card__header">
      <h1 class="text-xl font-semibold tracking-tight">Change password</h1>
      <% if (forced) { %><p class="card__description">You're using a temporary password. Choose your own to continue.</p><% } %>
    </div>
    <% if (error) { %><div class="alert alert--danger" role="alert"><div class="alert__content"><p class="alert__description text-danger"><%= error %></p></div></div><% } %>
    <form method="post" action="/password" class="flex flex-col gap-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="textfield textfield--full-width">
        <label class="label" for="current">Current password</label>
        <input class="input" type="password" id="current" name="current" autocomplete="current-password" required>
      </div>
      <div class="textfield textfield--full-width">
        <label class="label" for="new-password">New password</label>
        <input class="input" type="password" id="new-password" name="password" autocomplete="new-password" minlength="12" required>
        <p class="description">At least 12 characters.</p>
      </div>
      <div class="textfield textfield--full-width">
        <label class="label" for="confirm">New password again</label>
        <input class="input" type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="12" required>
      </div>
      <button class="button button--primary button--full-width">Change password</button>
    </form>
  </div>
</div>
<%- include("partials/foot") %>
