<%- include("partials/head") %>
<nav class="breadcrumbs mb-3 text-sm text-muted"><a class="hover:underline" href="/">Apps</a> <span class="mx-1">/</span> <a class="hover:underline" href="/apps/<%= app.name %>?tab=settings"><%= app.name %></a> <span class="mx-1">/</span> Secrets</nav>
<h1 class="text-2xl font-semibold tracking-tight">Secrets</h1>
<p class="mt-1 max-w-2xl text-sm text-muted">Values go straight to AWS Parameter Store, and nobody can view them afterwards. Staging and prod are always set separately. Add any name the app reads from <code>process.env</code>; the ones under <code>secrets:</code> in app.yaml are required, so a deploy fails until they're set.</p>

<nav class="mt-6 flex gap-1" aria-label="Environment">
  <% for (const e of ["staging", "prod"]) { %>
  <a class="nav-link" href="/apps/<%= app.name %>/secrets/<%= e %>" <%- e === env ? 'aria-current="page"' : "" %>><%= e === "staging" ? "Staging" : "Prod" %></a>
  <% } %>
</nav>

<% if (error) { %>
<div class="alert alert--danger mt-4" role="alert"><div class="alert__content"><p class="alert__description text-danger"><%= error %></p></div></div>
<% } %>

<% if (!canSet) { %>
  <div class="card card--default mt-4"><p class="empty-state"><%= app.name %> is <%= app.status.replace(/_/g, " ") %>, so its secrets can't be changed.</p></div>
<% } else if (!loadFailed) { %>

<% if (deployed && pending.length) { %>
<div class="alert alert--warning mt-4 flex-wrap" role="status">
  <div class="alert__content">
    <p class="alert__title">Not deployed yet</p>
    <p class="alert__description">
      <%= pending.map((s) => s[env].removing ? `${s.key} (to remove)` : s.key).join(", ") %>.
      <%= env === "staging" ? "Staging" : "Prod" %> keeps what it has until its next deploy.
      <% if (activeDeploy) { %><a class="link" href="/apps/<%= app.name %>/jobs/<%= activeDeploy.id %>">Deploy job #<%= activeDeploy.id %></a> is <%= activeDeploy.status %>; it takes changes saved before it started.<% } %>
    </p>
  </div>
  <% if (!activeDeploy && canDeploy) { %>
  <form method="post" action="/apps/<%= app.name %>/secrets/<%= env %>/deploy">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="button button--primary button--sm">Deploy <%= env %></button>
  </form>
  <% } %>
</div>
<% } %>

<form method="post" action="/apps/<%= app.name %>/secrets/<%= env %>" class="mt-4 flex flex-col gap-4" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (!secrets.length) { %>
  <div class="card card--default"><p class="empty-state">No secrets yet. Add one below.</p></div>
  <% } else { %>
  <div class="table-root table-root--primary">
    <div class="table__scroll-container">
      <table class="table__content">
        <thead class="table__header"><tr>
          <th class="table__column">Name and state in <%= env %></th><th class="table__column w-1/2">New value</th>
        </tr></thead>
        <tbody class="table__body">
        <% for (const s of secrets) { const cur = s[env]; %>
          <tr class="table__row">
            <%# Name, state and Remove share a cell so the value field stays on screen at phone width. %>
            <td class="table__cell">
              <div><%- include("partials/secret-name", { s, labelFor: `value-${s.key}` }) %></div>
              <div class="mt-1 text-sm">
                <%- include("partials/secret-status", { s: cur, required: s.required }) %>
                <%# formaction: Keep posts this form to another route, which only reads the key. %>
                <% if (cur.removing) { %><button class="button button--ghost button--sm ms-1" formaction="/apps/<%= app.name %>/secrets/<%= env %>/keep" name="key" value="<%= s.key %>">Keep</button><% } %>
              </div>
              <% if (!s.required && cur.set && !cur.removing) { %>
              <label class="mt-2 flex w-fit items-center gap-2 text-sm text-muted"><input class="size-4 accent-accent" type="checkbox" name="remove" value="<%= s.key %>"> Remove from <%= env %></label>
              <% } %>
            </td>
            <%# new-password stops browsers filling in the dashboard password, which would then be saved as this value. %>
            <td class="table__cell"><input class="input w-full min-w-28" type="password" id="value-<%= s.key %>" name="value:<%= s.key %>" autocomplete="new-password" placeholder="<%= cur.set ? "Leave empty to keep" : "" %>"></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <div class="card card--default gap-3">
    <p class="text-sm font-medium">Add a secret</p>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="textfield">
        <label class="label" for="new_name">Name</label>
        <input class="input font-mono" id="new_name" name="new_name" spellcheck="false" autocapitalize="characters" autocorrect="off" autocomplete="off" placeholder="e.g. STRIPE_KEY">
      </div>
      <div class="textfield">
        <label class="label" for="new_value">Value</label>
        <input class="input" type="password" id="new_value" name="new_value" autocomplete="new-password">
      </div>
    </div>
  </div>

  <details class="card card--default">
    <summary class="cursor-pointer text-sm font-medium">Or paste them from a .env file</summary>
    <div class="textfield mt-3">
      <label class="label" for="env_file">KEY=value lines</label>
      <%# spellcheck off: some browsers send what's typed to a spelling service. %>
      <textarea class="textarea min-h-40 font-mono" id="env_file" name="env_file" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder="STRIPE_KEY=sk_live_..."></textarea>
      <p class="text-xs text-muted">Names the app doesn't have yet are added. Empty values are skipped. Quoted values can span lines.</p>
    </div>
  </details>

  <div class="flex flex-wrap items-center gap-3">
    <% if (deployed) { %>
    <%# The first button is the one Enter presses. %>
    <button class="button button--primary" name="deploy" value="1">Save and deploy <%= env %></button>
    <button class="button button--secondary" name="deploy" value="0">Save only</button>
    <% } else { %>
    <button class="button button--primary" name="deploy" value="0">Save</button>
    <% } %>
  </div>
  <p class="text-sm text-muted">
    Empty fields keep their current value.
    <% if (deployed) { %>
    Save and deploy redeploys what <%= env %> runs, once. Save only keeps the changes for <%= env %>'s next deploy (<%= env === "staging" ? "the next merge to main, or Deploy" : "the next promote or rollback, or Deploy" %>); until then the app keeps its current values. A removed secret is deleted once a deploy has left it out.
    <% } else { %>
    <%= env === "prod" ? "Prod" : "Staging" %> hasn't been deployed yet; its first deploy will use these values.
    <% } %>
  </p>
</form>
<% } %>
<%- include("partials/foot") %>
