<%- include("partials/head") %>
<nav class="breadcrumbs mb-3 text-sm text-muted"><a class="hover:underline" href="/">Apps</a> <span class="mx-1">/</span> <a class="hover:underline" href="/apps/<%= app.name %>?tab=settings"><%= app.name %></a> <span class="mx-1">/</span> Secrets</nav>
<h1 class="text-2xl font-semibold tracking-tight">Secrets</h1>
<p class="mt-1 max-w-2xl text-sm text-muted">Values go straight to AWS Parameter Store, and nobody can view them afterwards. Staging and prod are always set separately. The names come from <code>secrets:</code> in app.yaml on main; to add one, ship that change first.</p>

<nav class="mt-6 flex gap-1" aria-label="Environment">
  <% for (const e of ["staging", "prod"]) { %>
  <a class="nav-link" href="/apps/<%= app.name %>/secrets/<%= e %>" <%- e === env ? 'aria-current="page"' : "" %>><%= e === "staging" ? "Staging" : "Prod" %></a>
  <% } %>
</nav>

<% if (error) { %>
<div class="alert alert--danger mt-4" role="alert"><div class="alert__content"><p class="alert__description text-danger"><%= error %></p></div></div>
<% } %>

<% if (!canSet) { %>
  <div class="card card--default mt-4"><p class="empty-state"><%= app.name %> is <%= app.status.replace(/_/g, " ") %>, so its secrets can't be changed.</p></div>
<% } else if (!secrets.length && !loadFailed) { %>
  <div class="card card--default mt-4"><p class="empty-state">No secrets are declared in app.yaml on main.</p></div>
<% } else if (secrets.length) { %>
<form method="post" action="/apps/<%= app.name %>/secrets/<%= env %>" class="mt-4 flex flex-col gap-4" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="table-root table-root--primary">
    <div class="table__scroll-container">
      <table class="table__content">
        <thead class="table__header"><tr>
          <th class="table__column">Name</th><th class="table__column">In <%= env %></th><th class="table__column w-1/2">New value</th>
        </tr></thead>
        <tbody class="table__body">
        <% for (const s of secrets) { const cur = s[env]; %>
          <tr class="table__row">
            <td class="table__cell font-mono text-xs"><label for="value-<%= s.key %>"><%= s.key %></label></td>
            <td class="table__cell whitespace-nowrap"><% if (cur.set) { %>set by <%= cur.lastSetBy %><div class="text-xs text-muted" title="<%= fmt(cur.lastSetAt) %>"><%= ago(cur.lastSetAt) %></div><% } else { %><span class="chip chip--soft chip--danger chip--sm"><span class="chip__label">not set</span></span><% } %></td>
            <%# new-password stops browsers filling in the dashboard password, which would then be saved as this value. %>
            <td class="table__cell"><input class="input w-full" type="password" id="value-<%= s.key %>" name="value:<%= s.key %>" autocomplete="new-password" placeholder="<%= cur.set ? "Leave empty to keep" : "" %>"></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <details class="card card--default">
    <summary class="cursor-pointer text-sm font-medium">Or paste them from a .env file</summary>
    <div class="textfield mt-3">
      <label class="label" for="env_file">KEY=value lines</label>
      <%# spellcheck off: some browsers send what's typed to a spelling service. %>
      <textarea class="textarea min-h-40 font-mono" id="env_file" name="env_file" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder="STRIPE_KEY=sk_live_..."></textarea>
      <p class="text-xs text-muted">Names that aren't declared are ignored, and so are empty values. Quoted values can span lines.</p>
    </div>
  </details>

  <div class="flex flex-wrap items-center gap-3">
    <button class="button button--primary"><%= deployed ? `Save and redeploy ${env}` : "Save" %></button>
    <span class="text-sm text-muted">
      Empty fields keep their current value.
      <%= deployed ? `Saving redeploys ${env} once, however many values change.` : `${env === "prod" ? "Prod" : "Staging"} hasn't been deployed yet; its first deploy will use these values.` %>
    </span>
  </div>
</form>
<% } %>
<%- include("partials/foot") %>
