<%- include("partials/head") %>
<h1 class="text-2xl font-semibold tracking-tight">Webhooks</h1>
<p class="mt-1 max-w-3xl text-sm text-muted">Every delivery GitHub sent to the deployer, newest first, with what the deployer did about it or why it did nothing. GitHub doesn't retry a failed delivery: <b>Sync with GitHub</b> on an app's page queues whatever a missed one would have. The GitHub App's own log is under its settings, Advanced.</p>

<form method="get" action="/deliveries" class="mt-6 flex flex-wrap items-end gap-3">
  <div class="textfield">
    <label class="label" for="app">App</label>
    <select class="input min-w-44" id="app" name="app">
      <option value="">All apps</option>
      <% for (const name of appNames) { %><option value="<%= name %>" <%= filter.app === name ? "selected" : "" %>><%= name %></option><% } %>
    </select>
  </div>
  <div class="textfield">
    <label class="label" for="outcome">Outcome</label>
    <select class="input min-w-36" id="outcome" name="outcome">
      <option value="">Any</option>
      <% for (const o of ["handled", "ignored", "rejected", "failed"]) { %><option value="<%= o %>" <%= filter.outcome === o ? "selected" : "" %>><%= o %></option><% } %>
    </select>
  </div>
  <button class="button button--secondary">Filter</button>
  <% if (filter.app || filter.outcome) { %><a class="button button--ghost" href="/deliveries">Clear</a><% } %>
</form>

<div class="mt-6">
<% if (!deliveries.length) { %>
  <div class="card card--default"><p class="empty-state"><%= filter.app || filter.outcome ? "No deliveries match." : "No deliveries yet. If you expected some, check the GitHub App's webhook URL (it ends in /webhooks/github) and that it's subscribed to Push and Pull request events." %></p></div>
<% } else { %>
<%- include("partials/deliveries-table", { rows: deliveries, showRepo: true }) %>
<p class="mt-3 text-xs text-muted">Showing the newest <%= deliveries.length %>. The deployer keeps the last <%= keep.toLocaleString("en") %>.</p>
<% } %>
</div>
<%- include("partials/foot") %>
