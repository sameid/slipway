<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (locals.refresh) { %><meta http-equiv="refresh" content="<%= refresh %>"><% } %>
<title><%= locals.title ? locals.title + " · " : "" %>slipway deployer</title>
<script src="<%= assets.themeJs %>"></script>
<script src="<%= assets.elapsedJs %>" defer></script>
<link rel="stylesheet" href="<%= assets.css %>">
</head>
<body class="min-h-dvh bg-background text-foreground antialiased">
<header class="sticky top-0 z-10 border-b border-separator/60 bg-surface/85 backdrop-blur">
  <div class="mx-auto flex min-h-14 max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2">
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
      <span class="grid size-7 place-items-center rounded-lg bg-accent text-accent-foreground">
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path d="M10 2.5a1 1 0 0 1 .7.3l4.5 4.5a1 1 0 0 1-1.4 1.4L11 5.9V13a1 1 0 1 1-2 0V5.9L6.2 8.7a1 1 0 0 1-1.4-1.4l4.5-4.5a1 1 0 0 1 .7-.3ZM4 15.5a1 1 0 0 1 1 1h10a1 1 0 1 1 0 2H5a2 2 0 0 1-2-2 1 1 0 0 1 1-1Z"/></svg>
      </span>
      <span>slipway <span class="font-normal text-muted">deployer</span></span>
    </a>
    <% if (locals.user && !locals.user.mustChangePassword) { %>
    <nav class="order-last -mx-3 flex w-full items-center gap-1 sm:order-none sm:mx-0 sm:w-auto">
      <a class="nav-link" href="/" <%- path === "/" || path.startsWith("/apps") ? 'aria-current="page"' : "" %>>Apps</a>
      <a class="nav-link" href="/deliveries" <%- path.startsWith("/deliveries") ? 'aria-current="page"' : "" %>>Webhooks</a>
      <% if (locals.user.isAdmin) { %><a class="nav-link" href="/users" <%- path.startsWith("/users") ? 'aria-current="page"' : "" %>>Users</a><% } %>
    </nav>
    <% } %>
    <div class="ms-auto flex items-center gap-2">
      <% if (locals.fake) { %><span class="chip chip--soft chip--warning chip--sm"><span class="chip__label">fake mode</span></span><% } %>
      <button type="button" class="button button--ghost button--sm button--icon-only" data-theme-toggle aria-label="Switch between light and dark mode" title="Switch between light and dark mode">
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 dark:hidden" aria-hidden="true"><path fill-rule="evenodd" d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z" clip-rule="evenodd"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor" class="hidden size-4 dark:block" aria-hidden="true"><path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.66 5.4a.75.75 0 0 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM6.46 14.6a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 1 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.6 15.66a.75.75 0 0 0 1.06-1.06l-1.06-1.06a.75.75 0 1 0-1.06 1.06l1.06 1.06ZM5.4 6.46a.75.75 0 0 0 1.06-1.06L5.4 4.34a.75.75 0 0 0-1.06 1.06L5.4 6.46Z"/></svg>
      </button>
      <% if (locals.user && !locals.user.mustChangePassword) { %>
      <a class="nav-link hidden sm:inline-flex" href="/password" title="Change password"><%= locals.user.email %></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <button class="button button--ghost button--sm">Sign out</button>
      </form>
      <% } %>
    </div>
  </div>
</header>
<main class="mx-auto max-w-6xl px-4 py-8">
<% if (locals.flash) { %>
<div class="alert alert--accent mb-6" role="status">
  <div class="alert__indicator"><svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a1 1 0 0 0 0 2v3a1 1 0 0 0 1 1h1a1 1 0 1 0 0-2v-3a1 1 0 0 0-1-1H9Z" clip-rule="evenodd"/></svg></div>
  <div class="alert__content"><p class="alert__description text-foreground"><%= locals.flash %></p></div>
</div>
<% } %>
