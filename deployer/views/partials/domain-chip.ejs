<%# A custom domain's status (domains.ts), in words. %>
<% const label = { requesting: "requesting", validating: "waiting for DNS", attaching: "attaching", active: "active", failed: "failed", removing: "removing" }[domain.status] ?? domain.status; -%>
<span class="chip chip--soft chip--sm chip--<%= tone(domain.status) %>"><span class="chip__label"><%= label %></span></span>
