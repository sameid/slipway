<%# A secret's name, marked when app.yaml requires it. Params: s, labelFor (optional input id). %>
<% if (locals.labelFor) { %><label class="font-mono text-xs" for="<%= labelFor %>"><%= s.key %></label><% } else { %><span class="font-mono text-xs"><%= s.key %></span><% } %>
<% if (s.required) { %><span class="chip chip--soft chip--accent chip--sm ms-1" title="Listed under secrets: in app.yaml on main, so deploys fail without it"><span class="chip__label">required</span></span><% } %>
