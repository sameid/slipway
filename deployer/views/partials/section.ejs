<%# A section heading. sectionNote is trusted markup from the template (it may hold <code>). %>
<div class="mb-3 mt-10 flex flex-wrap items-end justify-between gap-2 first:mt-0">
  <div>
    <h2 class="text-lg font-semibold tracking-tight"><%= heading %></h2>
    <% if (locals.sectionNote) { %><p class="text-sm text-muted"><%- sectionNote %></p><% } %>
  </div>
  <% if (locals.sectionLink) { %><a class="link text-sm" href="<%= sectionLink.href %>"><%= sectionLink.text %></a><% } %>
</div>
