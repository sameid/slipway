<%# One environment's state of a secret (secrets.ts SecretStatus). Params: s, required. %>
<% if (s.removing) { %>
<span class="chip chip--soft chip--warning chip--sm" title="The next deploy leaves it out, then it's deleted"><span class="chip__label">removing</span></span>
<% } else if (s.set) { %>
<span><%= s.lastSetBy ? `set by ${s.lastSetBy}` : "set" %></span><% if (s.notDeployed) { %> <span class="chip chip--soft chip--warning chip--sm" title="Saved after the last deploy started: the app doesn't have it yet"><span class="chip__label">not deployed</span></span><% } %>
<% if (s.lastSetAt) { %><div class="text-xs text-muted" title="<%= fmt(s.lastSetAt) %>"><%= ago(s.lastSetAt) %></div><% } %>
<% } else if (required) { %>
<span class="chip chip--soft chip--danger chip--sm" title="Required by app.yaml: deploys fail until it's set"><span class="chip__label">not set</span></span>
<% } else { %>
<span class="text-muted">not set</span>
<% } %>
